# ============================================
# WealthWise Daily — Faceless Finance Channel
# Copy this to .env and fill in your values
# ============================================

# OpenAI
OPENAI_API_KEY=sk-...

# ElevenLabs
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...   # Get from: https://elevenlabs.io/voice-library (try "Adam" or "Daniel")

# Pexels (free)
PEXELS_API_KEY=...        # Get from: https://www.pexels.com/api/

# Creatomate
CREATOMATE_API_KEY=...
CREATOMATE_TEMPLATE_ID=...  # Set after creating template in Creatomate dashboard

# YouTube (OAuth2 via n8n credential — set up in n8n UI)
# Go to n8n: Settings > Credentials > New > YouTube OAuth2 API

# Facebook
FACEBOOK_PAGE_ID=...
FACEBOOK_ACCESS_TOKEN=...   # Long-lived Page Access Token (60-day expiry)

# TikTok
TIKTOK_ACCESS_TOKEN=...     # From TikTok Developer Portal

# Google Sheets
GOOGLE_SHEET_ID=...         # From Google Sheets URL: /spreadsheets/d/{ID}/
GOOGLE_SHEETS_TAB=Log       # Sheet tab name (default: Log)
